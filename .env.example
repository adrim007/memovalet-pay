# MemoValet Pay: copy this file to .env.local and fill it in. Never commit .env.local.

# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox). Test money only.
PAYPAL_ENV=sandbox
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# A sandbox personal (buyer) account's email, so the test invoice can be paid in the sandbox.
PAYPAL_SANDBOX_BUYER_EMAIL=

# Any long random text. Signs the person's approval of an invoice.
MEMOVALET_APPROVAL_SECRET=

# AI for the assistant: a free Gemini key works (aistudio.google.com).
GEMINI_API_KEY=
